# ============================================================
# .gitignore — K3s Talos Homelab
# Sensitive files: NEVER in the repository
# ============================================================

# --- Real configuration data (contains real IPs, names, secrets) ---
*.tfvars
!*.tfvars.example

# --- Credentials and tokens ---
*.pem
*.key
*.env
.env
.env.local
.env.*.local
!env.example

# --- Generated kubeconfig (contains certificates and tokens) ---
.kubeconfig/
kubeconfig
kubeconfig.*
*.conf
!kubeconfig.example

# --- Temporary files and cache ---
.terraform/
.terraform.rc
terraform.tfstate
terraform.tfstate.backup
terraform.tfstate.*.backup
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
# .terraform.lock.hcl should be versioned to make providers reproducible.

# --- Local download (Talos images downloaded locally) ---
/tmp/talos-iso/
.artifacts/
*.iso
*.raw
*.raw.zst

# --- Logs and debug ---
*.log
logs/
debug.log

# --- OS and Editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.bak

# --- Temporary scripts ---
*.tmp
*.tmp.sh

# --- Terraform plan and status ---
tfplan
.nfs-status

