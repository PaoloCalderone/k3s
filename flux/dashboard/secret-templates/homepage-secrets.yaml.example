---
# Homepage Secrets Template
#
# ⚠️  QUESTO FILE È SOLO UN ESEMPIO — NON INCLUDERE VALORI REALI
#
# Per creare il secret sul cluster, eseguire:
#
#   kubectl create secret generic homepage-secrets \
#     --namespace=flux-system \
#     --from-literal=grafana-apikey='<INSERISCI-QUI-LA-TUA-API-KEY>'
#
# Per generare una API key Grafana:
#   1. Apri Grafana → Configuration → Service Accounts
#   2. Crea un'API key con permessi Reader
#   3. Copia il valore e usalo nel comando sopra

apiVersion: v1
kind: Secret
metadata:
  name: homepage-secrets
  namespace: flux-system
type: Opaque
data:
  # LA GRAFANA API KEY DEVE ESSERE BASE64-ENCODED
  # Esempio: echo -n "your-api-key-here" | base64
  grafana-apikey: "<BASE64-ENCODED-GRAFANA-API-KEY>"
