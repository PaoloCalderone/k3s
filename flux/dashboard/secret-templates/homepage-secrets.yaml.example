---
# Homepage Secrets Template
#
# THIS FILE IS ONLY AN EXAMPLE — DO NOT INCLUDE REAL VALUES
#
# To create the secret on the cluster, run:
#
#   kubectl create secret generic homepage-secrets \
#     --namespace=flux-system \
#     --from-literal=grafana-apikey='<INSERT-YOUR-API-KEY-HERE>'
#
# To generate a Grafana API key:
#   1. Open Grafana → Configuration → Service Accounts
#   2. Create an API key with Reader permissions
#   3. Copy the value and use it in the command above

apiVersion: v1
kind: Secret
metadata:
  name: homepage-secrets
  namespace: flux-system
type: Opaque
data:
  # THE GRAFANA API KEY MUST BE BASE64-ENCODED
  # Example: echo -n "your-api-key-here" | base64
  grafana-apikey: "<BASE64-ENCODED-GRAFANA-API-KEY>"
