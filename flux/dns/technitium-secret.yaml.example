---
# Technitium DNS Secret
#
# ⚠️  QUESTO FILE È SOLO UN ESEMPIO — NON INCLUDERE VALORI REALI
#
# Per creare il secret sul cluster, eseguire:
#
#   kubectl create secret generic technitium-dns-secret \
#     --namespace=dns \
#     --from-literal=admin-username='admin' \
#     --from-literal=admin-password='<INSERISCI-UNA-PASSWORD-STRONG-QUI>'
#
# Oppure esportalo dal deployment corrente:
#   kubectl get secret technitium-dns-secret -n dns -o yaml > technitium-secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: technitium-dns-secret
  namespace: dns
  labels:
    app: technitium-dns
type: Opaque
stringData:
  # Username per accedere alla web UI di Technitium
  admin-username: "admin"
  # Password per accedere alla web UI di Technitium
  # GENERARE UNA PASSWORD STRONG:
  #   openssl rand -base64 32
  admin-password: "CHANGE-ME-USE-A-STRONG-PASSWORD"
