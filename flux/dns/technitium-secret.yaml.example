---
# Technitium DNS Secret
#
# THIS FILE IS ONLY AN EXAMPLE — DO NOT INCLUDE REAL VALUES
#
# To create the secret on the cluster, run:
#
#   kubectl create secret generic technitium-dns-secret \
#     --namespace=dns \
#     --from-literal=admin-username='admin' \
#     --from-literal=admin-password='<INSERT-A-STRONG-PASSWORD-HERE>'
#
# Or export it from the current deployment:
#   kubectl get secret technitium-dns-secret -n dns -o yaml > technitium-secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: technitium-dns-secret
  namespace: dns
  labels:
    app: technitium-dns
type: Opaque
stringData:
  # Username to access the Technitium web UI
  admin-username: "admin"
  # Password to access the Technitium web UI
  # GENERATE A STRONG PASSWORD:
  #   openssl rand -base64 32
  admin-password: "CHANGE-ME-USE-A-STRONG-PASSWORD"
