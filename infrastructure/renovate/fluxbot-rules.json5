{
  "$schema": "https://raw.githubusercontent.com/fluxcd/flux2/manifests/flux-system/kustomization.yaml",
  "comments": [
    "These are the rules for Fluxbot (https://github.com/apps/fluxbot)",
    "Fluxbot monitors changes to the Talos/Kubernetes schema",
    "and creates PRs automatically for updating the manifests."
  ],

  "bot": {
    "name": "fluxbot",
    "trigger": {
      "issues": ["opened", "edited"],
      "pull_requests": ["opened", "edited", "review_requested"]
    }
  },

  // Fluxbot rules: create PRs when Talos/K8s resources change schema
  "rules": [
    {
      "name": "talos-schematic-upgrade",
      "type": "schematic",
      "enabled": true,
      "checks": ["talos-schematic"],
      "prLabels": ["talos", "automerge"],
      "prTitle": "upgrade talos schema"
    },
    {
      "name": "kubernetes-upgrade",
      "type": "kubernetes-version",
      "enabled": true,
      "checks": ["kubernetes-version"],
      "prLabels": ["kubernetes", "automerge"],
      "prTitle": "upgrade kubernetes version"
    },
    {
      "name": "docker-image-upgrade",
      "type": "docker-image",
      "enabled": true,
      "checks": ["docker-image"],
      "prLabels": ["docker", "automerge"],
      "prTitle": "upgrade docker image"
    },
    {
      "name": "nfs-csi-upgrade",
      "type": "docker-image",
      "enabled": true,
      "checks": ["docker-image"],
      "matchPackageNames": ["nfs-csi"],
      "prLabels": ["nfs-csi", "automerge"],
      "prTitle": "upgrade nfs-csi version"
    }
  ]
}
